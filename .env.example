# "fake" runs fully offline (deterministic embeddings + extractive answers).
# Set to "openai" and provide OPENAI_API_KEY for real GPT answers.
LLM_PROVIDER=fake
OPENAI_API_KEY=
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

CHAT_MODEL=gpt-4o-mini
ANALYSIS_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Host ports published by docker-compose. Change them if they are taken on your machine,
# and update DATABASE_URL / REDIS_URL below to match.
API_PORT=18000
POSTGRES_PORT=55432
REDIS_PORT=56379

# Used only when you run the API/worker directly on your machine (not inside Docker).
# Inside Docker, docker-compose.yml overrides these with the container hostnames.
DATABASE_URL=postgresql+asyncpg://vault:vault@localhost:55432/vault
REDIS_URL=redis://localhost:56379/0
STORAGE_DIR=./data/uploads

# key:owner pairs
API_KEYS=dev-key:demo,second-key:alice
LOG_JSON=false
LOG_LEVEL=INFO
